# Public Tenant Resolver Fixed Base URL (REQUIRED for tenant code resolution)
EXPO_PUBLIC_RESOLVER_BASE_URL=https://resolver.transbox.tech

# Default/Fallback Tenant API Base URL
EXPO_PUBLIC_API_BASE_URL=https://bg-beta.transbox.tech

# Optional Tenant Schema header (For development / debugging fallback ONLY)
EXPO_PUBLIC_TENANT_SCHEMA=tenant_bg_beta

# API Timeout in milliseconds (Default: 30000)
EXPO_PUBLIC_API_TIMEOUT_MS=30000
