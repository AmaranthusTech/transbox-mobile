# TRANSBOX Mobile Environment Configuration

# Environment mode: beta | production (Default: beta)
EXPO_PUBLIC_TRANSBOX_ENV=beta

# Tenant host suffix for dynamic Base URL construction (Default: -beta.transbox.tech)
EXPO_PUBLIC_TENANT_HOST_SUFFIX=-beta.transbox.tech

# API Timeout in milliseconds (Default: 30000)
EXPO_PUBLIC_API_TIMEOUT_MS=30000
